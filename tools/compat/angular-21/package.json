{
  "name": "etyma-compat-angular-21",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Builds a clean Angular 21 application against the packed Etyma tarballs. Not a workspace member: it must resolve the published package, not a symlink.",
  "scripts": {
    "build": "ng build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@analogjs/content": "2.7.0",
    "@analogjs/router": "2.7.0",
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/router": "21.2.21",
    "@etyma/core": "file:../.tarballs/etyma-core.tgz",
    "@etyma/angular": "file:../.tarballs/etyma-angular.tgz",
    "@etyma/analog": "file:../.tarballs/etyma-analog.tgz",
    "front-matter": "4.0.2",
    "marked": "15.0.12",
    "marked-gfm-heading-id": "4.1.4",
    "marked-highlight": "2.2.4",
    "marked-mangle": "1.1.13",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@etyma/core": "file:../.tarballs/etyma-core.tgz",
    "@etyma/angular": "file:../.tarballs/etyma-angular.tgz",
    "@etyma/analog": "file:../.tarballs/etyma-analog.tgz"
  }
}
