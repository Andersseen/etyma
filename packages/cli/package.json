{
  "name": "@etyma/cli",
  "version": "0.5.1",
  "description": "Command-line tools for Etyma catalogs: validate local or public remote catalogs, generate typed message contracts, and analyse static JS/TS message usage.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "cli",
    "messageformat",
    "mf2",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/etyma.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Andersseen/etyma/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Andersseen/etyma/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "etyma": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.lib.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "dev": "tsc --project tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@etyma/tooling": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
