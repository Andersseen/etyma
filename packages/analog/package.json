{
  "name": "@etyma/analog",
  "version": "0.0.0",
  "description": "AnalogJS integration for Etyma: URL-driven locale routing, SSR-translated HTML, hydration without a locale refetch, and localized SEO metadata.",
  "keywords": [
    "analog",
    "analogjs",
    "angular",
    "i18n",
    "internationalization",
    "ssr",
    "hydration",
    "seo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/etyma.git",
    "directory": "packages/analog"
  },
  "homepage": "https://github.com/Andersseen/etyma/tree/main/packages/analog#readme",
  "bugs": {
    "url": "https://github.com/Andersseen/etyma/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "ng-packagr --project ng-package.json --config tsconfig.lib.json",
    "dev": "ng-packagr --project ng-package.json --config tsconfig.lib.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "@analogjs/router": ">=2.6.0 <3",
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/router": "^21.0.0 || ^22.0.0",
    "@etyma/angular": "workspace:^"
  },
  "dependencies": {
    "@etyma/core": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/content": "2.7.0",
    "@analogjs/router": "2.7.0",
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@angular/build": "21.2.21",
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/router": "21.2.21",
    "@etyma/angular": "workspace:^",
    "@types/node": "22.20.1",
    "front-matter": "4.0.2",
    "jsdom": "30.0.1",
    "marked": "15.0.12",
    "marked-gfm-heading-id": "4.1.4",
    "marked-highlight": "2.2.4",
    "marked-mangle": "1.1.13",
    "ng-packagr": "21.2.7",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  }
}
