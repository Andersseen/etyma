{
  "name": "@etyma/tooling",
  "version": "0.8.0",
  "description": "Static validation for Etyma message catalogs (key parity, MessageFormat 2 syntax, external variable contracts) and static analysis of message usage in JS/TS source, as structured diagnostics.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "messageformat",
    "mf2",
    "validation",
    "linting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/etyma.git",
    "directory": "packages/tooling"
  },
  "homepage": "https://github.com/Andersseen/etyma/tree/main/packages/tooling#readme",
  "bugs": {
    "url": "https://github.com/Andersseen/etyma/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.lib.json",
    "dev": "tsc --project tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@etyma/core": "workspace:^",
    "messageformat": "4.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/compiler-rs": "^0.5.0",
    "@angular/compiler": "^21.0.0 || ^22.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler": {
      "optional": true
    },
    "@astrojs/compiler-rs": {
      "optional": true
    },
    "@angular/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "@astrojs/compiler-rs": "0.5.1",
    "@angular/compiler": "21.2.25",
    "@types/node": "26.6.4",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
