{
  "name": "@etyma/angular",
  "version": "0.1.0",
  "description": "Signal-native, zoneless-first Angular bindings for Etyma: typed translation keys, lazy locale catalogs and SSR transfer.",
  "keywords": [
    "angular",
    "i18n",
    "internationalization",
    "localization",
    "signals",
    "zoneless",
    "messageformat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/etyma.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/Andersseen/etyma/tree/main/packages/angular#readme",
  "bugs": {
    "url": "https://github.com/Andersseen/etyma/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "ng-packagr --project ng-package.json --config tsconfig.lib.json",
    "dev": "ng-packagr --project ng-package.json --config tsconfig.lib.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@etyma/core": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@angular/build": "21.2.21",
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@types/node": "26.4.0",
    "jsdom": "30.0.1",
    "ng-packagr": "21.2.7",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  }
}
