{
  "name": "etyma-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Etyma \u2014 an internationalization toolkit for Angular, AnalogJS and the modern web platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/etyma.git"
  },
  "homepage": "https://etyma.andersseen.dev",
  "bugs": {
    "url": "https://github.com/Andersseen/etyma/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.20.0 <11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @etyma/www run dev",
    "dev:playground": "pnpm --filter @etyma/playground run dev",
    "dev:workspace": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && turbo run typecheck test build",
    "package:check": "turbo run build --filter=./packages/* && node tools/scripts/package-check.mjs",
    "compat:check": "node tools/scripts/compat-check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
