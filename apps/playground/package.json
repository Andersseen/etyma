{
  "name": "@etyma/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dogfooding application for Etyma: a real Analog 2 app consuming the published package surface.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "BUILD_PRESET=cloudflare-pages vite build",
    "preview:cloudflare": "wrangler pages dev --port 8788",
    "deploy:cloudflare": "wrangler pages deploy",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "clean": "rimraf dist .turbo .nitro .wrangler test-results playwright-report"
  },
  "dependencies": {
    "@analogjs/content": "2.7.0",
    "@analogjs/router": "2.7.0",
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/platform-server": "21.2.21",
    "@angular/router": "21.2.21",
    "@etyma/analog": "workspace:^",
    "@etyma/angular": "workspace:^",
    "@etyma/core": "workspace:^",
    "front-matter": "4.0.2",
    "marked": "15.0.12",
    "marked-gfm-heading-id": "4.1.4",
    "marked-highlight": "2.2.4",
    "marked-mangle": "1.1.13",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "2.7.0",
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@angular/build": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
